stateDiagram-v2
    direction LR
    [*] --> Main

    state "Main — declared trajectory" as Main
    state "Missed day(s)" as Missed
    state "Ghost fork" as Ghost
    state "Archived" as Archived

    state "AI: drift watch" as DriftWatch
    state "Prompt 1 — name it?" as Prompt1
    state "Prompt 2 — final warning" as Prompt2
    state "Side branch (chosen)" as SideBranch
    state "Drift branch (forced)" as DriftBranch
    state "Main absorbed into drift" as Absorbed
    state "Counter-merge" as Counter

    %% —— the honest-day loop ——
    Main --> Main : daily commit, on track
    Main --> Missed : miss a day
    Missed --> Main : return within 3 days
    Missed --> Ghost : 3 consecutive misses
    Ghost --> Main : return within 15 days\n(wobble kept in history)
    Ghost --> Archived : no return in 15 days
    Archived --> Main : fork new main\nfrom the dead tip

    %% —— the drift loop ——
    Main --> DriftWatch : recurring non-required\nitem in commits
    DriftWatch --> Prompt1 : pattern holds\nacross consecutive days
    Prompt1 --> SideBranch : user names it
    Prompt1 --> DriftWatch : dismissed, still watching
    DriftWatch --> Prompt2 : pattern persists
    Prompt2 --> SideBranch : user names it
    Prompt2 --> DriftBranch : dismissed again — forced

    SideBranch --> Main : merge\n(declared goal met)
    DriftBranch --> Absorbed : ignored N more days —\nmain merges INTO drift
    Absorbed --> Counter : user forks back out
    Counter --> Main : rejoins the ghost line,\nwhich solidifies forward

    classDef mainStyle fill:#C2185B,color:#fff,stroke:#3A2E1C,stroke-width:1px
    classDef ghostStyle fill:#EDE0C4,color:#7A6A4A,stroke:#C2185B,stroke-dasharray:4 3
    classDef driftStyle fill:#C93B47,color:#fff,stroke:#3A2E1C,stroke-width:1px
    classDef goldStyle fill:#B8912F,color:#2A2010,stroke:#3A2E1C,stroke-width:1px

    class Main,Missed mainStyle
    class Ghost,Archived ghostStyle
    class DriftWatch,Prompt1,Prompt2,DriftBranch,Absorbed driftStyle
    class SideBranch,Counter goldStyle
